msgid "Address protocol"
msgstr "发布协议"

msgid "Avahi"
msgstr "Avahi"

msgid "Avahi Service Publisher"
msgstr "Bonjour 服务发布"

msgid "Display name"
msgstr "显示名称"

msgid "Disabling this option removes records generated by this application without stopping Avahi or changing records owned by other applications."
msgstr "关闭后将移除本应用生成的服务记录，但不会停止 Avahi 或影响其他应用。"

msgid "Each entry points a DNS-SD service instance to the LAN host that actually provides the service."
msgstr "每条记录把一个 DNS-SD 服务名称指向实际提供服务的局域网主机。"

msgid "Enable managed publishing"
msgstr "启用受管发布"

msgid "Enabled"
msgstr "启用"

msgid "Enabled entries"
msgstr "已启用条目"

msgid "Enter a fully-qualified host name such as nas.local."
msgstr "请输入完整主机名，例如 nas.local。"

msgid "Enter a fully-qualified host name, for example nas.local. If it is not already resolvable, also enter its static IPv4 address."
msgstr "请输入完整主机名，例如 nas.local。如果该名称目前无法解析，请同时填写其静态 IPv4 地址。"

msgid "Generated service files"
msgstr "已生成服务文件"

msgid "Global settings"
msgstr "全局设置"

msgid "IPv4 and IPv6"
msgstr "IPv4 与 IPv6"

msgid "IPv4 only"
msgstr "仅 IPv4"

msgid "IPv6 only"
msgstr "仅 IPv6"

msgid "Managed services"
msgstr "受管服务"

msgid "Not running"
msgstr "未运行"

msgid "Optional. Publishes an A record for the target host when that device does not publish its own mDNS address."
msgstr "可选。当目标设备没有自行发布 mDNS 地址时，为目标主机发布一条 A 记录。"

msgid "Port"
msgstr "端口"

msgid "Published host addresses"
msgstr "已发布主机地址"

msgid "Publish Bonjour/DNS-SD discovery records through the router for services hosted by other LAN devices. This application publishes discovery metadata only; clients connect directly to the target host."
msgstr "通过路由器现有的 Avahi，为局域网中的其他主机发布 Bonjour/DNS-SD 服务。这里只发布发现记录，客户端仍直接连接目标主机。"

msgid "Running"
msgstr "运行中"

msgid "Runtime status"
msgstr "运行状态"

msgid "Saving the configuration reloads the managed Avahi records. An offline target does not prevent saving and can use the same discovery record when it comes back online."
msgstr "保存并应用后，Avahi 会重新加载受管服务。目标主机离线不会阻止保存；主机重新上线后可继续使用同一发现记录。"

msgid "Service type"
msgstr "服务类型"

msgid "Target host"
msgstr "目标主机"

msgid "Target IPv4 address"
msgstr "目标 IPv4 地址"

msgid "The display name must not be empty or contain control characters."
msgstr "显示名称不能为空或包含控制字符。"

msgid "Use a DNS-SD service type such as _smb._tcp."
msgstr "服务类型格式应类似 _smb._tcp。"

msgid "Grant access to the LuCI Avahi service publisher"
msgstr "授予 LuCI Avahi 服务发布应用的访问权限"
msgid "Office NAS"
msgstr "办公 NAS"
