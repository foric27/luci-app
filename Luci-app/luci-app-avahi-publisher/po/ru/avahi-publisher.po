msgid "Address protocol"
msgstr "Семейство адресов"

msgid "Avahi"
msgstr "Avahi"

msgid "Avahi Service Publisher"
msgstr "Публикация сервисов Avahi"

msgid "Disabling this option removes records generated by this application without stopping Avahi or changing records owned by other applications."
msgstr "При отключении этого параметра записи, созданные приложением, будут удалены; Avahi при этом не останавливается, а записи других приложений не изменяются."

msgid "Display name"
msgstr "Отображаемое имя"

msgid "Each entry points a DNS-SD service instance to the LAN host that actually provides the service."
msgstr "Каждая запись привязывает экземпляр сервиса DNS-SD к хосту локальной сети, который фактически предоставляет сервис."

msgid "Enable managed publishing"
msgstr "Включить управляемую публикацию"

msgid "Enabled"
msgstr "Включено"

msgid "Enabled entries"
msgstr "Включённые записи"

msgid "Enter a fully-qualified host name such as nas.local."
msgstr "Введите полное доменное имя хоста, например nas.local."

msgid "Enter a fully-qualified host name, for example nas.local. If it is not already resolvable, also enter its static IPv4 address."
msgstr "Введите полное доменное имя хоста, например nas.local. Если оно ещё не разрешается, укажите также его статический IPv4-адрес."

msgid "Generated service files"
msgstr "Созданные файлы сервисов"

msgid "Global settings"
msgstr "Общие настройки"

msgid "Grant access to the LuCI Avahi service publisher"
msgstr "Предоставить доступ к публикации сервисов Avahi в LuCI"

msgid "IPv4 and IPv6"
msgstr "IPv4 и IPv6"

msgid "IPv4 only"
msgstr "Только IPv4"

msgid "IPv6 only"
msgstr "Только IPv6"

msgid "Managed services"
msgstr "Управляемые сервисы"

msgid "Not running"
msgstr "Не запущен"

msgid "Office NAS"
msgstr "Офисный NAS"

msgid "Optional. Publishes an A record for the target host when that device does not publish its own mDNS address."
msgstr "Необязательно. Публикует A-запись для целевого хоста, если устройство само не публикует свой mDNS-адрес."

msgid "Port"
msgstr "Порт"

msgid "Publish Bonjour/DNS-SD discovery records through the router for services hosted by other LAN devices. This application publishes discovery metadata only; clients connect directly to the target host."
msgstr "Публикует через роутер записи обнаружения Bonjour/DNS-SD для сервисов, размещённых на других устройствах локальной сети. Приложение публикует только метаданные обнаружения; клиенты подключаются напрямую к целевому хосту."

msgid "Published host addresses"
msgstr "Опубликованные адреса хостов"

msgid "Running"
msgstr "Запущен"

msgid "Runtime status"
msgstr "Состояние работы"

msgid "Saving the configuration reloads the managed Avahi records. An offline target does not prevent saving and can use the same discovery record when it comes back online."
msgstr "При сохранении управляемые записи Avahi перезагружаются. Недоступность целевого хоста не мешает сохранению: когда хост снова появится в сети, он сможет использовать ту же запись обнаружения."

msgid "Service type"
msgstr "Тип сервиса"

msgid "Target IPv4 address"
msgstr "Целевой IPv4-адрес"

msgid "Target host"
msgstr "Целевой хост"

msgid "The display name must not be empty or contain control characters."
msgstr "Отображаемое имя не должно быть пустым или содержать управляющие символы."

msgid "Use a DNS-SD service type such as _smb._tcp."
msgstr "Используйте тип сервиса DNS-SD, например _smb._tcp."
