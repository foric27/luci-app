msgid "(no log lines matched)"
msgstr "（无匹配的日志行）"

msgid "Access points only: LAN IP of the gateway for the short latency probe. Leave empty on the gateway."
msgstr "仅接入点：网关的 LAN IP，用于短延迟探测。在网关上请留空。"

msgid "Agent version"
msgstr "代理版本"

msgid "Base URL of the NetPulse server, e.g. http://192.168.1.226:3000."
msgstr "NetPulse 服务器的基本 URL，例如 http://192.168.1.226:3000。"

msgid "Connection"
msgstr "连接"

msgid "Connection OK (HTTP 200)."
msgstr "连接正常（HTTP 200）。"

msgid "Connection failed (%s)."
msgstr "连接失败（%s）。"

msgid "Connection of the local agent to the NetPulse server. "
msgstr "本地代理与 NetPulse 服务器的连接。"

msgid "Full probe cycle. Plain seconds or a Go duration (\"30\", \"15s\", \"1m\")."
msgstr "完整探测周期。可直接填写秒数或 Go 时长（\"30\"、\"15s\"、\"1m\"）。"

msgid "Gateway only: public IP probed for WAN loss/latency (e.g. 1.1.1.1). Leave empty on access points."
msgstr "仅网关：用于 WAN 丢包/延迟探测的公网 IP（如 1.1.1.1）。在接入点上请留空。"

msgid "Gateway ping target"
msgstr "网关 ping 目标"

msgid "Grant access to the NetPulse agent pages"
msgstr "授予访问 NetPulse 代理页面的权限"

msgid "Heartbeat"
msgstr "心跳"

msgid "Identifier of this router in NetPulse (as created in Settings → Agents)."
msgstr "此路由器在 NetPulse 中的标识符（在 设置 → 代理 中创建）。"

msgid "Local state of the NetPulse agent on this router (slug “%s”). The network-wide view lives in the NetPulse web app."
msgstr "此路由器上 NetPulse 代理的本地状态（slug “%s”）。全网视图位于 NetPulse Web 应用中。"

msgid "Local state of the NetPulse agent on this router. The network-wide view lives in the NetPulse web app."
msgstr "此路由器上 NetPulse 代理的本地状态。全网视图位于 NetPulse Web 应用中。"

msgid "Memory (RSS)"
msgstr "内存（RSS）"

msgid "NetPulse"
msgstr "NetPulse"

msgid "NetPulse agent"
msgstr "NetPulse 代理"

msgid "NetPulse agent restarted."
msgstr "NetPulse 代理已重启。"

msgid "No"
msgstr "否"

msgid "No heartbeat yet"
msgstr "尚无心跳"

msgid "Not installed"
msgstr "未安装"

msgid "Open NetPulse ↗"
msgstr "打开 NetPulse ↗"

msgid "Per-device token (64 hex). Shown once when the agent is created on the server."
msgstr "设备令牌（64 位十六进制）。在服务器上创建代理时仅显示一次。"

msgid "Process uptime"
msgstr "进程运行时间"

msgid "Push interval"
msgstr "推送间隔"

msgid "Pushing (%s ago)"
msgstr "推送中（%s 前）"

msgid "Recent log"
msgstr "最近日志"

msgid "Restart agent"
msgstr "重启代理"

msgid "Restart failed (exit code %s)."
msgstr "重启失败（退出码 %s）。"

msgid "Restart failed: %s"
msgstr "重启失败：%s"

msgid "Restarting"
msgstr "正在重启"

msgid "Restarting the NetPulse agent…"
msgstr "正在重启 NetPulse 代理…"

msgid "Running (PID %d)"
msgstr "运行中（PID %d）"

msgid "SHA-256 of the server SubjectPublicKeyInfo in hex. Required when the server URL is https. Get it with: curl http://server/fingerprint"
msgstr "服务器 SubjectPublicKeyInfo 的 SHA-256（十六进制）。当服务器 URL 为 https 时必填。获取方法：curl http://server/fingerprint"

msgid "Server URL"
msgstr "服务器 URL"

msgid "Server fingerprint (SPKI)"
msgstr "服务器指纹（SPKI）"

msgid "Service"
msgstr "服务"

msgid "Settings"
msgstr "设置"

msgid "Slug"
msgstr "Slug"

msgid "Stalled (%s ago)"
msgstr "停滞（%s 前）"

msgid "Start on boot"
msgstr "开机启动"

msgid "Status"
msgstr "状态"

msgid "Stopped"
msgstr "已停止"

msgid "Test connection"
msgstr "测试连接"

msgid "Test failed: %s"
msgstr "测试失败：%s"

msgid "Testing"
msgstr "测试中"

msgid "Testing connection to the server…"
msgstr "正在测试与服务器的连接…"

msgid "Token"
msgstr "令牌"

msgid "WAN ping target"
msgstr "WAN ping 目标"

msgid "Yes"
msgstr "是"
