msgid "(no log lines matched)"
msgstr "(в журнале нет подходящих строк)"

msgid "Access points only: LAN IP of the gateway for the short latency probe. Leave empty on the gateway."
msgstr "Только для точек доступа: LAN-IP шлюза для короткого замера задержки. На самом шлюзе оставьте пустым."

msgid "Agent version"
msgstr "Версия агента"

msgid "Base URL of the NetPulse server, e.g. http://192.168.1.226:3000."
msgstr "Базовый URL сервера NetPulse, например http://192.168.1.226:3000."

msgid "Connection"
msgstr "Подключение"

msgid "Connection OK (HTTP 200)."
msgstr "Подключение работает (HTTP 200)."

msgid "Connection failed (%s)."
msgstr "Не удалось подключиться (%s)."

msgid "Connection of the local agent to the NetPulse server. "
msgstr "Подключение локального агента к серверу NetPulse. "

msgid "Full probe cycle. Plain seconds or a Go duration (\"30\", \"15s\", \"1m\")."
msgstr "Полный цикл опроса. Просто секунды или длительность Go («30», «15s», «1m»)."

msgid "Gateway only: public IP probed for WAN loss/latency (e.g. 1.1.1.1). Leave empty on access points."
msgstr "Только для шлюза: публичный IP для проверки потерь и задержки на WAN (например, 1.1.1.1). На точках доступа оставьте пустым."

msgid "Gateway ping target"
msgstr "Цель ping для шлюза"

msgid "Grant access to the NetPulse agent pages"
msgstr "Доступ к страницам агента NetPulse"

msgid "Heartbeat"
msgstr "Heartbeat"

msgid "Identifier of this router in NetPulse (as created in Settings → Agents)."
msgstr "Идентификатор этого роутера в NetPulse (создаётся в настройках → агенты)."

msgid "Local state of the NetPulse agent on this router (slug “%s”). The network-wide view lives in the NetPulse web app."
msgstr "Локальное состояние агента NetPulse на этом роутере (slug «%s»). Обзор всей сети — в веб-приложении NetPulse."

msgid "Local state of the NetPulse agent on this router. The network-wide view lives in the NetPulse web app."
msgstr "Локальное состояние агента NetPulse на этом роутере. Обзор всей сети — в веб-приложении NetPulse."

msgid "Memory (RSS)"
msgstr "Память (RSS)"

msgid "NetPulse"
msgstr "NetPulse"

msgid "NetPulse agent"
msgstr "Агент NetPulse"

msgid "NetPulse agent restarted."
msgstr "Агент NetPulse перезапущен."

msgid "No"
msgstr "Нет"

msgid "No heartbeat yet"
msgstr "Heartbeat ещё не получен"

msgid "Not installed"
msgstr "Не установлен"

msgid "Open NetPulse ↗"
msgstr "Открыть NetPulse ↗"

msgid "Per-device token (64 hex). Shown once when the agent is created on the server."
msgstr "Токен устройства (64 hex). Показывается один раз при создании агента на сервере."

msgid "Process uptime"
msgstr "Время работы процесса"

msgid "Push interval"
msgstr "Интервал отправки"

msgid "Pushing (%s ago)"
msgstr "Отправка (%s назад)"

msgid "Recent log"
msgstr "Последние записи журнала"

msgid "Restart agent"
msgstr "Перезапустить агента"

msgid "Restart failed (exit code %s)."
msgstr "Не удалось перезапустить (код выхода %s)."

msgid "Restart failed: %s"
msgstr "Не удалось перезапустить: %s"

msgid "Restarting"
msgstr "Перезапуск"

msgid "Restarting the NetPulse agent…"
msgstr "Перезапуск агента NetPulse…"

msgid "Running (PID %d)"
msgstr "Работает (PID %d)"

msgid "SHA-256 of the server SubjectPublicKeyInfo in hex. Required when the server URL is https. Get it with: curl http://server/fingerprint"
msgstr "SHA-256 SubjectPublicKeyInfo сервера в hex. Обязателен, если URL сервера — https. Получить: curl http://server/fingerprint"

msgid "Server URL"
msgstr "URL сервера"

msgid "Server fingerprint (SPKI)"
msgstr "Отпечаток сервера (SPKI)"

msgid "Service"
msgstr "Служба"

msgid "Settings"
msgstr "Настройки"

msgid "Slug"
msgstr "Slug"

msgid "Stalled (%s ago)"
msgstr "Нет данных (%s назад)"

msgid "Start on boot"
msgstr "Запускать при загрузке"

msgid "Status"
msgstr "Состояние"

msgid "Stopped"
msgstr "Остановлен"

msgid "Test connection"
msgstr "Проверить подключение"

msgid "Test failed: %s"
msgstr "Проверка не удалась: %s"

msgid "Testing"
msgstr "Проверка"

msgid "Testing connection to the server…"
msgstr "Проверка подключения к серверу…"

msgid "Token"
msgstr "Токен"

msgid "WAN ping target"
msgstr "Цель ping для WAN"

msgid "Yes"
msgstr "Да"
